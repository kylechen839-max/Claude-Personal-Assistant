# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
NOTION_TOKEN=

# Home Assistant (only with [home_assistant] enabled = true): your HA
# address and a long-lived access token (HA profile -> Security).
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=

# Optional overrides (normally set in config.toml)
# CLAUDE_MODEL=claude-sonnet-5-5
# WAKEWORD_MODEL_PATH=keywords/hey_claude.onnx

# Phone web app access token: created here automatically the first time you
# run `python -m assistant --mode web` (or set 32+ random characters yourself).
# WEB_TOKEN=

# Spotify ([spotify] enabled = true): the Client ID of your own app at
# developer.spotify.com (no client secret is needed or used). README "Spotify".
# SPOTIFY_CLIENT_ID=
