# Vendored VAD files: keep byte-exact (their SHA-256 is checked in tests)
kwil/web/vad/*.js -text
kwil/web/vad/*.mjs -text
kwil/web/vad/*.wasm binary
kwil/web/vad/*.onnx binary

# Windows batch files must keep CRLF line endings
*.cmd text eol=crlf

# Shell scripts must keep LF (bash reads a CRLF shebang as "bash\r")
*.sh text eol=lf
*.command text eol=lf

# Canvas calendar feed fixtures: keep the CRLF line endings and folds byte-exact
tests/fixtures/*.ics -text
